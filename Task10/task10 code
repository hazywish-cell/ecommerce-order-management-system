# Task X: Advanced SQL Queries and Business Analysis

USE ECommerceDB;

-- 1. Find Products Above Average Price

SELECT
product_id,
product_name,
category,
price
FROM products
WHERE price > (
SELECT AVG(price)
FROM products
)
ORDER BY price DESC;

-- 2. Find Products Above Their Category Average Price

SELECT
p.product_id,
p.product_name,
p.category,
p.price
FROM products p
WHERE p.price > (
SELECT AVG(p2.price)
FROM products p2
WHERE p2.category = p.category
)
ORDER BY p.category, p.price DESC;

-- 3. Identify Customers with the Maximum Number of Orders

SELECT
c.customer_id,
c.customer_name,
COUNT(o.order_id) AS total_orders
FROM customers c
JOIN orders o
ON c.customer_id = o.customer_id
GROUP BY
c.customer_id,
c.customer_name
HAVING COUNT(o.order_id) = (
SELECT MAX(order_count)
FROM (
SELECT COUNT(*) AS order_count
FROM orders
GROUP BY customer_id
) AS customer_orders
);

-- 4. Find Customers Spending Above the Average

SELECT
c.customer_id,
c.customer_name,
SUM(od.quantity * od.unit_price) AS total_purchase
FROM customers c
JOIN orders o
ON c.customer_id = o.customer_id
JOIN order_details od
ON o.order_id = od.order_id
GROUP BY
c.customer_id,
c.customer_name
HAVING SUM(od.quantity * od.unit_price) > (
SELECT AVG(customer_total)
FROM (
SELECT
o2.customer_id,
SUM(od2.quantity * od2.unit_price) AS customer_total
FROM orders o2
JOIN order_details od2
ON o2.order_id = od2.order_id
GROUP BY o2.customer_id
) AS customer_spending
)
ORDER BY total_purchase DESC;

-- 5. Find Customers Who Have Never Placed an Order

SELECT
c.customer_id,
c.customer_name,
c.city
FROM customers c
WHERE NOT EXISTS (
SELECT 1
FROM orders o
WHERE o.customer_id = c.customer_id
);

-- 6. Identify Best-Selling Products

SELECT
p.product_id,
p.product_name,
SUM(od.quantity) AS total_quantity_sold,
SUM(od.quantity * od.unit_price) AS total_revenue
FROM products p
JOIN order_details od
ON p.product_id = od.product_id
GROUP BY
p.product_id,
p.product_name
ORDER BY total_quantity_sold DESC;

-- 7. Perform Category-Wise Sales Analysis

SELECT
p.category,
SUM(od.quantity) AS total_units_sold,
SUM(od.quantity * od.unit_price) AS total_revenue,
COUNT(DISTINCT o.order_id) AS total_orders
FROM products p
JOIN order_details od
ON p.product_id = od.product_id
JOIN orders o
ON od.order_id = o.order_id
GROUP BY p.category
ORDER BY total_revenue DESC;

-- 8. Generate an Advanced Customer Purchase Report

SELECT
c.customer_id,
c.customer_name,
c.city,
COUNT(DISTINCT o.order_id) AS total_orders,
COALESCE(SUM(od.quantity * od.unit_price), 0) AS total_purchase,
CASE
WHEN COALESCE(SUM(od.quantity * od.unit_price), 0) >= 10000
THEN 'High Value Customer'
WHEN COALESCE(SUM(od.quantity * od.unit_price), 0) >= 5000
THEN 'Medium Value Customer'
ELSE 'Low Value Customer'
END AS customer_category
FROM customers c
LEFT JOIN orders o
ON c.customer_id = o.customer_id
LEFT JOIN order_details od
ON o.order_id = od.order_id
GROUP BY
c.customer_id,
c.customer_name,
c.city
ORDER BY total_purchase DESC;

-- 9. Find the Most Expensive Product in Each Category

SELECT
p.product_id,
p.product_name,
p.category,
p.price
FROM products p
WHERE p.price = (
SELECT MAX(p2.price)
FROM products p2
WHERE p2.category = p.category
)
ORDER BY p.category;

-- 10. Find Customers with the Highest Total Purchase Amount

SELECT
c.customer_id,
c.customer_name,
SUM(od.quantity * od.unit_price) AS total_purchase
FROM customers c
JOIN orders o
ON c.customer_id = o.customer_id
JOIN order_details od
ON o.order_id = od.order_id
GROUP BY
c.customer_id,
c.customer_name
HAVING SUM(od.quantity * od.unit_price) = (
SELECT MAX(customer_total)
FROM (
SELECT
o2.customer_id,
SUM(od2.quantity * od2.unit_price) AS customer_total
FROM orders o2
JOIN order_details od2
ON o2.order_id = od2.order_id
GROUP BY o2.customer_id
) AS customer_totals
)
ORDER BY total_purchase DESC;

