-- Inventory Status Report
SELECT
    i.inventory_id,
    s.seller_name,
    p.product_name,
    i.stock_quantity,
    i.status
FROM inventory i
JOIN seller s
    ON i.seller_id = s.seller_id
JOIN product p
    ON i.product_id = p.product_id
ORDER BY i.inventory_id;
