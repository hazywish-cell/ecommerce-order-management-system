-- =========================================================
-- TASK 1: CREATE REVIEW AND RATING TABLES
-- =========================================================

SELECT * FROM Review;

SELECT * FROM Rating;


-- =========================================================
-- TASK 2: STORE CUSTOMER FEEDBACK AND RATINGS
-- =========================================================

SELECT
    Review.review_id,
    Customer.customer_name,
    Product.product_name,
    Review.review_text,
    Rating.rating,
    Review.review_date
FROM Review
JOIN Customer
ON Review.customer_id = Customer.customer_id
JOIN Product
ON Review.product_id = Product.product_id
JOIN Rating
ON Review.review_id = Rating.review_id;


-- =========================================================
-- TASK 3: RETRIEVE PRODUCT REVIEW DETAILS
-- =========================================================

SELECT
    Product.product_name,
    Customer.customer_name,
    Review.review_text,
    Rating.rating,
    Review.review_date
FROM Product
JOIN Review
ON Product.product_id = Review.product_id
JOIN Customer
ON Review.customer_id = Customer.customer_id
JOIN Rating
ON Review.review_id = Rating.review_id;


-- =========================================================
-- TASK 4: CALCULATE AVERAGE PRODUCT RATINGS
-- =========================================================

SELECT
    Product.product_name,
    AVG(Rating.rating) AS average_rating
FROM Product
JOIN Review
ON Product.product_id = Review.product_id
JOIN Rating
ON Review.review_id = Rating.review_id
GROUP BY Product.product_id, Product.product_name;


-- =========================================================
-- COUNT TOTAL REVIEWS FOR EACH PRODUCT
-- =========================================================

SELECT
    Product.product_name,
    COUNT(Rating.rating) AS total_reviews
FROM Product
JOIN Review
ON Product.product_id = Review.product_id
JOIN Rating
ON Review.review_id = Rating.review_id
GROUP BY Product.product_id, Product.product_name;


-- =========================================================
-- FIND HIGHEST RATING GIVEN TO EACH PRODUCT
-- =========================================================

SELECT
    Product.product_name,
    MAX(Rating.rating) AS highest_rating
FROM Product
JOIN Review
ON Product.product_id = Review.product_id
JOIN Rating
ON Review.review_id = Rating.review_id
GROUP BY Product.product_id, Product.product_name;


-- =========================================================
-- FIND LOWEST RATING GIVEN TO EACH PRODUCT
-- =========================================================

SELECT
    Product.product_name,
    MIN(Rating.rating) AS lowest_rating
FROM Product
JOIN Review
ON Product.product_id = Review.product_id
JOIN Rating
ON Review.review_id = Rating.review_id
GROUP BY Product.product_id, Product.product_name;


-- =========================================================
-- TASK 5: IDENTIFY HIGHLY RATED PRODUCTS
-- Products with average rating >= 4.5
-- =========================================================

SELECT
    Product.product_name,
    AVG(Rating.rating) AS average_rating
FROM Product
JOIN Review
ON Product.product_id = Review.product_id
JOIN Rating
ON Review.review_id = Rating.review_id
GROUP BY Product.product_id, Product.product_name
HAVING AVG(Rating.rating) >= 4.5;


-- =========================================================
-- FIND THE HIGHEST-RATED PRODUCT
-- =========================================================

SELECT
    Product.product_name,
    AVG(Rating.rating) AS average_rating
FROM Product
JOIN Review
ON Product.product_id = Review.product_id
JOIN Rating
ON Review.review_id = Rating.review_id
GROUP BY Product.product_id, Product.product_name
ORDER BY average_rating DESC
LIMIT 1;


-- =========================================================
-- DISPLAY PRODUCTS FROM HIGHEST TO LOWEST RATING
-- =========================================================

SELECT
    Product.product_name,
    AVG(Rating.rating) AS average_rating
FROM Product
JOIN Review
ON Product.product_id = Review.product_id
JOIN Rating
ON Review.review_id = Rating.review_id
GROUP BY Product.product_id, Product.product_name
ORDER BY average_rating DESC;


-- =========================================================
-- DISPLAY PRODUCTS WITH THEIR REVIEW COUNT AND RATING
-- =========================================================

SELECT
    Product.product_name,
    COUNT(Rating.rating) AS total_reviews,
    AVG(Rating.rating) AS average_rating
FROM Product
JOIN Review
ON Product.product_id = Review.product_id
JOIN Rating
ON Review.review_id = Rating.review_id
GROUP BY Product.product_id, Product.product_name
ORDER BY average_rating DESC;
