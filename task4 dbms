-- ============================================================
-- 13. CUSTOMER ORDER HISTORY
-- ============================================================

SELECT
    c.Customer_Name,
    o.Order_ID,
    o.Order_Date,
    p.Product_Name,
    od.Quantity,
    od.Unit_Price,
    (od.Quantity * od.Unit_Price) AS Subtotal
FROM Customer c
JOIN Orders o
    ON c.Customer_ID = o.Customer_ID
JOIN Order_Details od
    ON o.Order_ID = od.Order_ID
JOIN Product p
    ON od.Product_ID = p.Product_ID;


-- ============================================================
-- 14. FIND TOTAL AMOUNT FOR EACH ORDER
-- ============================================================

SELECT
    o.Order_ID,
    c.Customer_Name,
    SUM(od.Quantity * od.Unit_Price) AS Total_Amount
FROM Orders o
JOIN Customer c
    ON o.Customer_ID = c.Customer_ID
JOIN Order_Details od
    ON o.Order_ID = od.Order_ID
GROUP BY
    o.Order_ID,
    c.Customer_Name;


-- ============================================================
-- 15. FIND TOTAL SPENDING OF EACH CUSTOMER
-- ============================================================

SELECT
    c.Customer_Name,
    SUM(od.Quantity * od.Unit_Price) AS Total_Spending
FROM Customer c
JOIN Orders o
    ON c.Customer_ID = o.Customer_ID
JOIN Order_Details od
    ON o.Order_ID = od.Order_ID
GROUP BY c.Customer_ID, c.Customer_Name;


-- ============================================================
-- 16. FIND MAXIMUM ORDER AMOUNT
-- ============================================================

SELECT
    MAX(Total_Amount) AS Maximum_Order_Amount
FROM
(
    SELECT
        o.Order_ID,
        SUM(od.Quantity * od.Unit_Price) AS Total_Amount
    FROM Orders o
    JOIN Order_Details od
        ON o.Order_ID = od.Order_ID
    GROUP BY o.Order_ID
) AS Order_Total;


-- ============================================================
-- 17. FIND SECOND MAXIMUM ORDER AMOUNT
-- ============================================================

SELECT
    MAX(Total_Amount) AS Second_Maximum_Order
FROM
(
    SELECT
        o.Order_ID,
        SUM(od.Quantity * od.Unit_Price) AS Total_Amount
    FROM Orders o
    JOIN Order_Details od
        ON o.Order_ID = od.Order_ID
    GROUP BY o.Order_ID
) AS Order_Total
WHERE Total_Amount <
(
    SELECT MAX(Total_Amount)
    FROM
    (
        SELECT
            o2.Order_ID,
            SUM(od2.Quantity * od2.Unit_Price) AS Total_Amount
        FROM Orders o2
        JOIN Order_Details od2
            ON o2.Order_ID = od2.Order_ID
        GROUP BY o2.Order_ID
    ) AS Maximum_Order
);


